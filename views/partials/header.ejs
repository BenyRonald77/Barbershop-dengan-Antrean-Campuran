<!doctype html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Barbershop Antrean' %> - Barbershop Antrean</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="topbar">
    <div class="topbar-inner">
      <a class="brand" href="/">Barbershop Antrean</a>
      <nav class="nav" aria-label="Navigasi utama">
        <a href="/" class="<%= currentPath === '/' ? 'active' : '' %>">Dashboard</a>
        <a href="/antrean" class="<%= currentPath === '/antrean' ? 'active' : '' %>">Papan Antrean</a>
        <a href="/booking" class="<%= currentPath.startsWith('/booking') ? 'active' : '' %>">Booking</a>
        <a href="/antrean/cek" class="<%= currentPath === '/antrean/cek' ? 'active' : '' %>">Cek Status</a>
        <a href="/kapster" class="<%= currentPath === '/kapster' ? 'active' : '' %>">Kapster</a>
        <a href="/layanan" class="<%= currentPath === '/layanan' ? 'active' : '' %>">Layanan</a>
      </nav>
    </div>
  </header>
  <main class="page">
    <% if (locals.flashSuccess) { %>
      <div class="flash flash-success" role="status"><%= flashSuccess %></div>
    <% } %>
    <% if (locals.flashError) { %>
      <div class="flash flash-error" role="alert"><%= flashError %></div>
    <% } %>
